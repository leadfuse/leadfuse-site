{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/funnel/**",
              "components/navigation/**",
              "ui_kits/website/**",
              "ui_kits/website/v1-archive/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Poppins|Instrument Serif))/i]",
        "message": "Font not provided by the design system. Available: Poppins, Instrument Serif."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:red|black|amber|orange|tint|outline|on-dark)$/]",
        "message": "<Badge> tone must be one of 'red' | 'black' | 'amber' | 'orange' | 'tint' | 'outline' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandPattern'] > JSXAttribute > JSXIdentifier[name!=/^(?:cols|rows|cell|tileScale|base|key|ref|className|style|children)$/]",
        "message": "<BrandPattern> doesn't accept that prop. Declared props: cols, rows, cell, tileScale, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|ghost|on-dark|outline-on-dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'outline' | 'ghost' | 'on-dark' | 'outline-on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|accentTop|pad|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, accentTop, pad, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:line|shadow|dark|black|red)$/]",
        "message": "<Card> variant must be one of 'line' | 'shadow' | 'dark' | 'black' | 'red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> pad must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dark|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|onClose|footer|children|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, onClose, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Emblem'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|shape|tile|base|key|ref|className|style|children)$/]",
        "message": "<Emblem> doesn't accept that prop. Declared props: size, shape, tile, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Emblem'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|app|circle)$/]",
        "message": "<Emblem> shape must be one of 'square' | 'app' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Emblem'] > JSXAttribute[name.name='tile'] > Literal[value!=/^(?:red|black)$/]",
        "message": "<Emblem> tile must be one of 'red' | 'black'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:center|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: center, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|required|hint|error|dark|children|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, required, hint, error, dark, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:pad|hover|blur|children|key|ref|className|style|children)$/]",
        "message": "<GlassPanel> doesn't accept that prop. Declared props: pad, hover, blur, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlassPanel'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<GlassPanel> pad must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|ghost|block|children|key|ref|className|style|children)$/]",
        "message": "<GlowButton> doesn't accept that prop. Declared props: size, ghost, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<GlowButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|label|children|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, size, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline|ghost|on-dark)$/]",
        "message": "<IconButton> variant must be one of 'primary' | 'dark' | 'outline' | 'ghost' | 'on-dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|error|dark|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, error, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Input> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|base|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, base."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|on-dark|on-red)$/]",
        "message": "<Logo> variant must be one of 'primary' | 'on-dark' | 'on-red'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dark|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|kicker|dark|center|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: eyebrow, title, kicker, dark, center."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|dark|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: options, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='SerifAccent'] > JSXAttribute > JSXIdentifier[name!=/^(?:red|children|key|ref|className|style|children)$/]",
        "message": "<SerifAccent> doesn't accept that prop. Declared props: red, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaTone|dark|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: label, value, delta, deltaTone, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:amber|orange|red|muted)$/]",
        "message": "<Stat> deltaTone must be one of 'amber' | 'orange' | 'red' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|dark|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, dark."
